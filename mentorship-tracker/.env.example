# Postgres connection string. Vercel fills this in when you attach a Neon database.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Access codes. The code a member types decides which program they are in.
ACCELERATOR_CODE=change-me
ACADEMY_CODE=change-me-too

# PIN that unlocks /admin.
ADMIN_PASSWORD=change-me

# Any random string. Signs the admin login cookie.
AUTH_SECRET=change-me
