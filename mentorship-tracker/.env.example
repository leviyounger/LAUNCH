# Postgres connection string. Vercel fills this in automatically when you
# attach a Neon database to the project.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The code mentees type once before they can submit.
FORM_CODE=levi

# The PIN that unlocks the dashboard at /admin. Levi's is 8054, which is also
# the built in default, so this only needs setting if you want to change it.
ADMIN_PASSWORD=8054

# Any random string. Signs the admin login cookie.
AUTH_SECRET=change-me-too
